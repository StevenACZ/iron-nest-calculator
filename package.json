    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "prettier": "^3.9.6"
  },
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
